{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@features/*": [
        "./src/presentation/features/*"
      ],
      "@shared/*": [
        "./src/presentation/shared/*"
      ],
      "@context/*": [
        "./src/presentation/context/*"
      ],
      "@core/*": [
        "./src/core/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}